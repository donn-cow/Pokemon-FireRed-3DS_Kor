+// Width of the character at *pp (1 or 2 bytes, a particle against *prev);
+// advances *pp past it.
+static s32 KoGlyphWidthAt(s32 (*func)(u16, bool32), const u8 **pp, bool32 isJapanese, u16 *prev)
+{
+    u16 glyph;
+
+    if (isJapanese)
+        return func(*(*pp)++, isJapanese);
+    glyph = Ko_NextGlyph(pp, prev);
+    if (glyph == 0xFFFF)
+        return 0;
+    return func(glyph, FALSE);
