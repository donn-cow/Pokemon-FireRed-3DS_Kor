diff --git a/src/korean_text.c b/src/korean_text.c
new file mode 100644
index 0000000..a84637e
--- /dev/null
+++ b/src/korean_text.c
@@ -0,0 +1,120 @@
+#include "global.h"
+#include "characters.h"
+#include "korean_text.h"
+
+#ifdef KOREAN_TEXT
+
+#include "korean_text_tables.h"
+
+// 0: open syllable, 1: final consonant, 2: final ㄹ (decides (으)로)
+static u8 FinalClass(u16 glyph)
+{
+    u8 page = glyph >> 8;
+    u8 low = glyph & 0xFF;
+
+    if (page >= 2 && page <= 11)
+    {
+        u16 idx = (page - 2) * 239 + low - 1;
+        if (low == 0 || low > 0xEF || idx >= 2350)
+            return 0;
+        return (sKoFinalClass[idx >> 2] >> ((idx & 3) * 2)) & 3;
+    }
+    if (page != 0)
+        return 0;
+
+    // The 30 single-byte syllables are all open (로 스 코 키 아 트 레 이 ...).
+    switch (low)
+    {
+    // Digits, read as Sino-Korean numbers: 영 일 이 삼 사 오 육 칠 팔 구
+    case CHAR_0: return 1;
+    case CHAR_1: return 2;
+    case CHAR_3: return 1;
+    case CHAR_6: return 1;
+    case CHAR_7: return 2;
+    case CHAR_8: return 2;
+    // Latin letters spelled out: 엘 엠 엔 알 end in a consonant
+    case CHAR_L: case CHAR_l: return 2;
+    case CHAR_R: case CHAR_r: return 2;
+    case CHAR_M: case CHAR_m: return 1;
+    case CHAR_N: case CHAR_n: return 1;
+    }
+    return 0;
+}
+
+bool8 Ko_IsJosa(u8 lead, u8 trail)
+{
+    return lead == KO_LEAD_JOSA && trail >= KO_JOSA_WA_GWA && trail <= KO_JOSA_EU && trail != 0xF3;
+}
+
+u16 Ko_JosaGlyph(u8 trail, u16 prevGlyph)
+{
+    u8 fc = FinalClass(prevGlyph);
+
+    switch (trail)
+    {
+    case KO_JOSA_WA_GWA:
+        return fc ? KO_GLYPH_GWA : KO_GLYPH_WA;
+    case KO_JOSA_EUN_NEUN:
+        return fc ? KO_GLYPH_EUN : KO_GLYPH_NEUN;
+    case KO_JOSA_EUL_REUL:
+        return fc ? KO_GLYPH_EUL : KO_GLYPH_REUL;
+    case KO_JOSA_I_GA:
+        return fc ? KO_GLYPH_I : KO_GLYPH_GA;
+    case KO_JOSA_I:
+        return fc ? KO_GLYPH_I : 0;
+    case KO_JOSA_EU:
+        return fc == 1 ? KO_GLYPH_EU : 0;
+    }
+    return KO_GLYPH(KO_LEAD_JOSA, trail);
+}
+
+u16 Ko_NextGlyph(const u8 **str, u16 *prevGlyph)
+{
+    const u8 *s = *str;
+    u16 glyph;
+
+    if (KO_IS_LEAD(s[0]) && s[1] != EOS)
+    {
+        if (Ko_IsJosa(s[0], s[1]))
+        {
+            glyph = Ko_JosaGlyph(s[1], *prevGlyph);
+            *str = s + 2;
+            if (glyph == 0)
+                return 0xFFFF;
+            *prevGlyph = glyph;
+            return glyph;
+        }
+        glyph = KO_GLYPH(s[0], s[1]);
+        *str = s + 2;
+    }
+    else
+    {
+        glyph = s[0];
+        *str = s + 1;
+    }
+    *prevGlyph = glyph;
+    return glyph;
+}
+
+bool8 Ko_EncodeHangul(u32 codepoint, u8 *out)
+{
+    s32 lo = 0, hi = ARRAY_COUNT(sKoUnicode) - 1;
+
+    while (lo <= hi)
+    {
+        s32 mid = (lo + hi) / 2;
+        if (sKoUnicode[mid] == codepoint)
+        {
+            out[0] = KO_LEAD_FIRST + mid / 239;
+            out[1] = mid % 239 + 1;
+            return TRUE;
+        }
+        if (sKoUnicode[mid] < codepoint)
+            lo = mid + 1;
+        else
+            hi = mid - 1;
+    }
+    return FALSE;
+}
+
+#endif // KOREAN_TEXT
