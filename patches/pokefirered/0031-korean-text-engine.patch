index 0000000..2d3e3d7
--- /dev/null
+++ b/include/korean_text.h
@@ -0,0 +1,43 @@
+#ifndef GUARD_KOREAN_TEXT_H
+#define GUARD_KOREAN_TEXT_H
+
+// Korean text (the K260613 translation's encoding).
+//
+//  - 0x37..0x40 lead + 0x01..0xEF trail: KS X 1001 Hangul (2350 syllables)
+//  - 0x41 lead: symbols, and EE..F4 particles chosen from the previous syllable
+//  - 30 single-byte syllables share page 0 with the latin glyphs
+//
+// The fonts hold 14 pages of 256 glyphs; a 2-byte character's glyph code is
+// ((lead - 0x35) << 8) | trail, so pages 2..12 are the lead bytes 0x37..0x41.
+
+#ifdef KOREAN_TEXT
+
+#define KO_LEAD_FIRST 0x37
+#define KO_LEAD_LAST  0x41
+#define KO_LEAD_JOSA  0x41
+
+#define KO_IS_LEAD(c) ((u8)(c) >= KO_LEAD_FIRST && (u8)(c) <= KO_LEAD_LAST)
+#define KO_GLYPH(lead, trail) ((u16)((((lead) - 0x35) << 8) | (u8)(trail)))
+
+// 0x41 xx particles: the glyph depends on the character drawn before it.
+#define KO_JOSA_WA_GWA   0xEE // 와/과
+#define KO_JOSA_EUN_NEUN 0xEF // 은/는
+#define KO_JOSA_EUL_REUL 0xF0 // 을/를
+#define KO_JOSA_I_GA     0xF1 // 이/가
+#define KO_JOSA_I        0xF2 // 이 (copula: 이다/이면), nothing after a vowel
+#define KO_JOSA_EU       0xF4 // 으 of (으)로, nothing after a vowel or ㄹ
+
+bool8 Ko_IsJosa(u8 lead, u8 trail);
+// The glyph a particle draws after `prevGlyph` (0 when it draws nothing).
+u16 Ko_JosaGlyph(u8 trail, u16 prevGlyph);
+// Reads one character at *str (1 or 2 bytes) and advances *str. Returns the
+// glyph code, resolving particles against *prevGlyph, which it updates. A
+// particle that draws nothing returns 0xFFFF.
+u16 Ko_NextGlyph(const u8 **str, u16 *prevGlyph);
+// A Unicode Hangul syllable -> its 2 game bytes. Returns FALSE when the
+// syllable is outside KS X 1001 (the Korean ROM's 2350).
+bool8 Ko_EncodeHangul(u32 codepoint, u8 *out);
+
+#endif // KOREAN_TEXT
+
+#endif // GUARD_KOREAN_TEXT_H
